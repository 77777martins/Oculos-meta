# =============================================================================
# Copie para `.env` e preencha. NUNCA commite o `.env`.
# Variáveis NEXT_PUBLIC_* são expostas ao navegador: jamais coloque segredos nelas.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
# URL pública canônica (sem barra final). Usada em SEO, e-mails e webhooks.
APP_URL=http://localhost:3000

# --- Banco de dados (PostgreSQL) -------------------------------------------------
# Em produção use a URL "pooled" (PgBouncer) em DATABASE_URL e a direta em DIRECT_URL.
DATABASE_URL=postgresql://oculos:oculos_dev@localhost:5432/oculos_meta?schema=public
DIRECT_URL=postgresql://oculos:oculos_dev@localhost:5432/oculos_meta?schema=public

# --- Segurança ---------------------------------------------------------------
# Segredo para HMAC (hash de IP em logs, assinatura de cookies auxiliares).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Protege o endpoint de cron (Vercel envia "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# --- Mercado Pago (https://www.mercadopago.com.br/developers/panel/app) -------
# Access Token: SOMENTE servidor. Use TEST-... em desenvolvimento e APP_USR-... em produção.
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta dos webhooks (Suas integrações > Webhooks > Assinatura secreta).
MERCADOPAGO_WEBHOOK_SECRET=
# Public Key: é PÚBLICA por design (usada para tokenizar cartões no navegador).
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Texto que aparece na fatura do cartão (até 13 caracteres).
MERCADOPAGO_STATEMENT_DESCRIPTOR=OCULOSMETA

# --- E-mail transacional (Resend — https://resend.com) ------------------------
# Sem chave em desenvolvimento, os e-mails são exibidos no console do servidor.
RESEND_API_KEY=
EMAIL_FROM="Óculos Meta Store <nao-responda@seudominio.com.br>"

# --- Armazenamento de imagens (Vercel Blob) ------------------------------------
# Sem token em desenvolvimento, uploads vão para public/uploads (NÃO use em produção).
BLOB_READ_WRITE_TOKEN=

# --- Administrador inicial (usado por `npm run admin:create`) -------------------
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
