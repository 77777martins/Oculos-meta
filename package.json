{
  "name": "oculos-meta-store",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce de óculos inteligentes Meta — Next.js, Prisma, PostgreSQL e Mercado Pago.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --trace off",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "launch:cleanup": "tsx scripts/cleanup-test-data.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@mercadopago/sdk-react": "^1.0.7",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^11.12.0",
    "@vercel/blob": "^2.9.0",
    "lucide-react": "^1.73.0",
    "mercadopago": "^3.6.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "zod": "$zod",
    "deepmerge-ts": "^8.0.0"
  }
}
